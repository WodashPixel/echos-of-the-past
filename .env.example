# Copy to .env for local development (never commit the real .env)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=qwen/qwen3.8-27b
FLAG=ISTEC{example_flag_here}
DOWNLOAD_CODE=EXAMPLE-CODE
# In production the gated .docx is injected as base64 via DOCX_B64 (set on Render).
# Locally you can instead place the file at ./secret/1978_05_19.docx
# DOCX_B64=
# Secret used to sign download tokens (set a stable value on Render).
TOKEN_SECRET=change-me-to-a-long-random-string
RATE_LIMIT_MS=15000
# Comma-separated allowed origins (your Vercel site). Use * only for testing.
ALLOWED_ORIGIN=https://echoes-of-the-past-phi.vercel.app
PORT=3001
